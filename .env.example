SMSPOOL_PROMPT_COUNTRY_SELECTION=true

# ChatGPT API SMS local pool. Format: phone----url, or phone and url in two lines.
CHATGPT_API_SMS_POOL_FILE=data/auth/chatgpt_api_sms_pool.txt
CHATGPT_API_SMS_SERVICE=custom-api
CHATGPT_API_SMS_COUNTRY_TOP_N=10
CHATGPT_API_SMS_PROVIDER_THRESHOLD=20
CHATGPT_API_SMS_PROMPT_PROVIDER_SELECTION=true
CHATGPT_API_SMS_POLL_INTERVAL=5
CHATGPT_API_SMS_MAX_ATTEMPTS=60
CHATGPT_API_SMS_COUNTRY_SELECT=
CHATGPT_API_SMS_PROMPT_COUNTRY_SELECTION=true

# ============ PayPal 人机验证码处理 ============
# 模式：manual = 暂停等手动处理（默认），api = 调用打码平台自动解
PAYPAL_CAPTCHA_MODE=manual
# 手动模式等待超时（秒），超时后继续尝试
PAYPAL_CAPTCHA_TIMEOUT=180

# 打码平台配置（PAYPAL_CAPTCHA_MODE=api 时生效）
# 支持 capsolver / twocaptcha / yescaptcha
CAPTCHA_API_PROVIDER=capsolver

# CapSolver（推荐，速度快，支持 reCAPTCHA/hCaptcha）
# 注册：https://www.capsolver.com/  价格约 $0.8-2/1000次
CAPSOLVER_API_KEY=

# 2Captcha（老牌平台，人工打码）
# 注册：https://2captcha.com/  价格约 $2-3/1000次
TWOCAPTCHA_API_KEY=

# YesCaptcha（支持 reCAPTCHA v2 / hCaptcha）
# 注册：https://yescaptcha.com/
YESCAPTCHA_API_KEY=

# ============ PayPal 代理配置 ============
# 开关：是否为 PayPal 流程启用代理（每个线程走不同代理）
PAYPAL_USE_PROXY=false
# 美国支付/绑卡代理池。
# 格式：每行一个，支持 http://user:pass@host:port 或 socks5://host:port
PAYPAL_PROXY_FILE_US=data/proxies/proxies_us.txt
# 日本代理流程2代理池。
PAYPAL_PROXY_FILE_JP=data/proxies/proxies_jp.txt
# 兼容旧配置；新逻辑优先读取 PAYPAL_PROXY_FILE_US / PAYPAL_PROXY_FILE_JP。
PAYPAL_PROXY_FILE=data/proxies/proxies_us.txt

# PayPal 卡密自动兑换（从卡密池自动兑换并写入 cards.txt）
PAYPAL_CARD_REDEEM_ENABLED=true
PAYPAL_CARD_REDEEM_API_URL=https://card.52bankcard.com/api/exchange/verify
PAYPAL_CARD_REDEEM_API_KEY=
PAYPAL_CARD_REDEEM_CODE_FIELD=key
PAYPAL_CARD_REDEEM_TIMEOUT=20
PAYPAL_CARD_REDEEM_MAX_AUTO_FETCH=20
PAYPAL_CARD_REDEEM_APPEND_WHEN_STATUS_USED=true
PAYPAL_CARD_CODES_FILE=data/paypal/card_codes.txt
PAYPAL_CARD_CODES_USED_FILE=data/paypal/card_codes_used.txt
PAYPAL_CARD_CODES_FAILED_FILE=data/paypal/card_codes_failed.txt

